# Build-Verzeichnisse
build/
build-*/
*-build/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
Testing/
install_manifest.txt

# Qt / QML Cache
*.qmlc
*.jsc
.qmake.stash

# makepkg (Arch-Paketbau)
# ACHTUNG: hier stand früher zusätzlich "src/" - das schloss versehentlich
# auch das echte C++-Quellcode-Verzeichnis (src/*.cpp) aus, da makepkg bei
# leerem source=() denselben Namen für sein eigenes srcdir verwendet.
# PKGBUILD baut deshalb jetzt bewusst nach $startdir/build statt $srcdir/build
# (siehe Kommentar dort) - "src/" braucht hier also gar nicht mehr zu stehen.
pkg/
*.pkg.tar.*

# Editoren / IDEs
.vscode/
.idea/
*.kate-swp
.kdev4/
*.kdev4
.claude/

# macOS
.DS_Store

